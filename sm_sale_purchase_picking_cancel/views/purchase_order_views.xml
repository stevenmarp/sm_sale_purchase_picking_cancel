<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_force_cancel" model="ir.ui.view">
        <field name="name">purchase.order.form.force.cancel</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_cancel" type="object" string="Force Cancel"
                        groups="purchase.group_purchase_manager"
                        confirm="This will cancel the order, its receptions and bills, reversing stock moves. Continue?"
                        invisible="state != 'purchase'"/>
            </xpath>
        </field>
    </record>
</odoo>
