<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_force_cancel" model="ir.ui.view">
        <field name="name">account.move.form.force.cancel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_cancel" type="object" string="Force Cancel"
                        groups="account.group_account_manager"
                        confirm="This will reset the invoice to draft and cancel it. Continue?"
                        invisible="state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
