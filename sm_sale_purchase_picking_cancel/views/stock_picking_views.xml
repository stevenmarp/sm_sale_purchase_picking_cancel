<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_force_cancel" model="ir.ui.view">
        <field name="name">stock.picking.form.force.cancel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_force_cancel" type="object" string="Force Cancel"
                        groups="stock.group_stock_manager"
                        confirm="This will cancel the transfer and reverse its stock moves to restore quantities. Continue?"
                        attrs="{'invisible': [('state', '!=', 'done')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
